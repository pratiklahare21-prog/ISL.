# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Postgres (Drizzle)
DATABASE_URL=postgresql://isl_user:isl_password@localhost:5432/isl_translator

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ml-service (Python FastAPI) location — the server proxies/validates
# session ownership; actual video/landmark traffic goes browser -> ml-service
# directly over its own websocket for lowest latency.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_WS_URL=ws://localhost:8000
